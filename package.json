{
  "name": "usebruno",
  "private": true,
  "workspaces": [
    "packages/bruno-app",
    "packages/bruno-electron",
    "packages/bruno-cli",
    "packages/bruno-common",
    "packages/bruno-converters",
    "packages/bruno-schema",
    "packages/bruno-schema-types",
    "packages/bruno-query",
    "packages/bruno-js",
    "packages/bruno-lang",
    "packages/bruno-tests",
    "packages/bruno-toml",
    "packages/bruno-graphql-docs",
    "packages/bruno-requests",
    "packages/bruno-filestore",
    "packages/bruno-sqlite"
  ],
  "homepage": "https://github.com/nyawit-dev/ngaRing-Api",
  "author": {
    "name": "nyawit.dev",
    "email": "ringga.itdev@batamfast.com",
    "url": "https://github.com/nyawit-dev/ngaRing-Api"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@faker-js/faker": "^7.6.0",
    "@jest/globals": "^29.2.0",
    "@lydell/node-pty-win32-arm64": "1.1.0",
    "@lydell/node-pty-win32-x64": "1.1.0",
    "@playwright/test": "1.62.1",
    "@rollup/plugin-json": "^6.1.0",
    "@stylistic/eslint-plugin": "^5.3.1",
    "@types/adm-zip": "^0.5.8",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.14.1",
    "@typescript-eslint/parser": "^8.39.0",
    "adm-zip": "^0.6.0",
    "concurrently": "^8.2.2",
    "cross-env": "10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-diff": "^2.0.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fs-extra": "^11.1.1",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "jest": "^29.2.0",
    "lodash-es": "^4.17.23",
    "nano-staged": "^0.8.0",
    "playwright": "1.62.1",
    "pretty-quick": "^3.1.3",
    "randomstring": "^1.2.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.6"
  },
  "scripts": {
    "setup": "bun ./scripts/setup.js",
    "watch:converters": "node ./scripts/run-pkg.js bruno-converters watch",
    "dev": "bun ./scripts/dev.js",
    "watch": "bun run dev:watch",
    "dev:watch": "bun ./scripts/dev-hot-reload.js",
    "dev:web": "bun run --cwd packages/bruno-app dev",
    "build:web": "bun run --cwd packages/bruno-app build",
    "dev:electron": "bun run --cwd packages/bruno-electron dev",
    "dev:electron:debug": "bun run --cwd packages/bruno-electron debug",
    "storybook": "bun run --cwd packages/bruno-app storybook",
    "build:bruno-common": "node ./scripts/run-pkg.js bruno-common build",
    "build:bruno-requests": "node ./scripts/run-pkg.js bruno-requests build",
    "build:bruno-filestore": "node ./scripts/run-pkg.js bruno-filestore build",
    "build:bruno-sqlite": "node ./scripts/run-pkg.js bruno-sqlite build",
    "build:bruno-converters": "node ./scripts/run-pkg.js bruno-converters build",
    "build:bruno-query": "node ./scripts/run-pkg.js bruno-query build",
    "build:graphql-docs": "node ./scripts/run-pkg.js bruno-graphql-docs build",
    "build:schema-types": "node ./scripts/run-pkg.js bruno-schema-types build",
    "build:electron": "bun ./scripts/build-electron.js",
    "build:electron:benchmark": "cross-env BRUNO_BENCHMARK=true npm run build:benchmark --workspace=packages/bruno-app && cross-env BRUNO_BENCHMARK=true node scripts/build-electron.js",
    "build:electron:mac": "node ./scripts/build-electron.js mac",
    "build:electron:win": "node ./scripts/build-electron.js win",
    "build:electron:linux": "node ./scripts/build-electron.js linux",
    "build:electron:deb": "./scripts/build-electron.sh deb",
    "build:electron:rpm": "./scripts/build-electron.sh rpm",
    "build:electron:snap": "./scripts/build-electron.sh snap",
    "watch:common": "node ./scripts/run-pkg.js bruno-common watch",
    "watch:requests": "node ./scripts/run-pkg.js bruno-requests watch",
    "test:codegen": "node playwright/codegen.ts",
    "test:e2e": "playwright test --project=default --project=system-pac --project=mock-server",
    "test:e2e:ssl": "playwright test --project=ssl",
    "test:e2e:auth": "playwright test --project=auth",
    "test:e2e:mock-server": "playwright test --project=mock-server",
    "test:e2e:sanity": "playwright test --project=default --project=system-pac --grep @sanity",
    "test:benchmark": "playwright test --config=playwright.benchmark.config.ts",
    "lint": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096\" npx eslint",
    "lint:fix": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096\" npx eslint --fix",
    "prepare": "husky || true"
  },
  "nano-staged": {
    "*.{js,ts,jsx}": [
      "npm run lint:fix"
    ]
  },
  "overrides": {
    "axios": "1.18.0",
    "tar": "7.5.22",
    "app-builder-lib": {
      "tar": "7.5.22"
    },
    "brace-expansion@5": "5.0.9",
    "minimatch@10": {
      "brace-expansion": "5.0.9"
    },
    "rollup": "3.30.0",
    "pbkdf2": "3.1.5",
    "electron-store": {
      "conf": {
        "json-schema-typed": "8.0.1"
      }
    }
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "git-url-parse": "^14.1.0"
  },
  "publisher": "nyawit.dev"
}
